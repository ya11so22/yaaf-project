+    /**
+     * CreateDistributionWithTags is addressed by the valueless flag {@code ?WithTags}. A flag with no
+     * {@code =} can be absent from the parsed query parameters, so the raw query is checked as well,
+     * as S3RequestParser.hasQueryParam does for S3's subresource flags.
+     */
+    private static boolean hasQueryFlag(UriInfo uriInfo, String name) {
+        if (uriInfo.getQueryParameters().containsKey(name)) {
+            return true;
+        }
+        String query = uriInfo.getRequestUri().getRawQuery();
+        if (query == null) {
+            return false;
+        }
+        for (String pair : query.split("&")) {
+            int eq = pair.indexOf('=');
+            String key = eq >= 0 ? pair.substring(0, eq) : pair;
+            if (key.equals(name)) {
+                return true;
+            }
+        }
+        return false;
+    }
