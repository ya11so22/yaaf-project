#!/usr/bin/env bash
#MISE description="Remove the local AWS and everything it started: Floci, the cluster, the local state file, .aws and .kube"
# Nothing persists (PLAN.md D39), so there is nothing to keep and nothing to confirm. `up` builds it all again from git.
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
CLUSTER="yaaf-dev"
DEV="infra/environments/dev"

if docker info >/dev/null 2>&1; then
  # The containers Floci started itself (the cluster, its registry) first: they hold the floci-net network open.
  ids="$(docker ps -aq --filter label=floci=true)"
  [ -z "$ids" ] || docker rm -f $ids >/dev/null
  docker compose -f "$DEV/compose.yaml" down -v --remove-orphans
  # The cluster's datastore volume carries no floci=true label (quirk Q2), so it goes by name.
  docker volume rm -f "floci-eks-$CLUSTER" >/dev/null 2>&1 || true
fi
# The bootstrap root's state is a local file (the bucket cannot hold its own creator's state). Left behind, the next
# `up` would believe a bucket exists in a Floci that no longer has it.
rm -f "$DEV/bootstrap/terraform.tfstate" "$DEV/bootstrap/terraform.tfstate.backup"
rm -rf .aws .kube
echo "Removed. \`mise run up\` builds everything again from git."
