#!/usr/bin/env bash
# The project's fast checks (ADR-0009). One script, used by the pre-commit hook and by CI, so the
# two cannot drift.
#
#   scripts/check         staged-changes secret scan; a missing tool is reported as SKIP
#   scripts/check --ci    full-history secret scan; a missing tool is a failure
set -uo pipefail

ci=false
if [ "${1:-}" = "--ci" ]; then ci=true; fi

cd "$(git rev-parse --show-toplevel)"

# Pinned by digest. Bump deliberately. rhysd/actionlint v1.7.12, gitleaks v8.30.1.
ACTIONLINT_IMAGE="rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667"
GITLEAKS_IMAGE="ghcr.io/gitleaks/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"

failed=0

# Docker on Windows needs a Windows-style path for the bind mount.
mount_path() {
  if command -v cygpath >/dev/null 2>&1; then cygpath -m "$PWD"; else printf '%s' "$PWD"; fi
}

run() {
  local name="$1"; shift
  local out
  printf '%s ... ' "$name"
  if out="$("$@" 2>&1)"; then
    echo ok
  else
    echo FAIL
    printf '%s\n' "$out" | sed 's/^/    /'
    failed=$((failed + 1))
  fi
}

unavailable() {
  if $ci; then
    echo "$1 ... FAIL ($2; required with --ci)"
    failed=$((failed + 1))
  else
    echo "$1 ... SKIP ($2)"
  fi
}

have_docker() { command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; }

docker_run() {
  env MSYS_NO_PATHCONV=1 docker run --rm \
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e GIT_CONFIG_VALUE_0=/repo \
    -v "$(mount_path):/repo" -w /repo "$@"
}

if command -v tofu >/dev/null 2>&1; then
  run "tofu fmt" tofu fmt -check -recursive -diff infra
else
  unavailable "tofu fmt" "tofu not installed"
fi

run "change-detection tests" bash .github/scripts/changed-services.test.sh
run "content-tag tests" bash .github/scripts/content-tag.test.sh

if command -v kubectl >/dev/null 2>&1; then
  run "image pin tests" bash .github/scripts/bump-images.test.sh
else
  unavailable "image pin tests" "kubectl not installed"
fi

if have_docker; then
  run "actionlint" docker_run "$ACTIONLINT_IMAGE" -color=false
  if $ci; then
    run "gitleaks (full history)" docker_run "$GITLEAKS_IMAGE" git /repo --no-banner --redact
  else
    run "gitleaks (staged changes)" docker_run "$GITLEAKS_IMAGE" git /repo --pre-commit --staged --no-banner --redact
  fi
else
  unavailable "actionlint" "docker not available"
  unavailable "gitleaks" "docker not available"
fi

if [ "$failed" -ne 0 ]; then
  echo "$failed check(s) failed"
  exit 1
fi
echo "all checks passed"
