#!/usr/bin/env bash
# The project's fast checks (PLAN.md D9, PLAN.md D25). One script, used by the pre-commit hook, `mise run check` and CI, so
# the three cannot drift. The tools are the locked versions from mise.toml (no Docker needed).
#
#   scripts/check         staged-changes secret scan; a missing tool is reported as SKIP
#   scripts/check --ci    full-history secret scan; a missing tool is a failure
set -uo pipefail

ci=false
if [ "${1:-}" = "--ci" ]; then ci=true; fi

cd "$(git rev-parse --show-toplevel)"

# Called from a git hook or a plain shell there is no mise environment: run again inside it. In CI jdx/mise-action has
# already installed the tools and exported the environment, so K8S_VERSION is set and this is skipped.
if [ -z "${K8S_VERSION:-}" ]; then
  if command -v mise >/dev/null 2>&1; then exec mise exec -- bash "$0" "$@"; fi
  echo "K8S_VERSION is not set: run this through mise (mise run check)" >&2
  exit 1
fi

# As a pre-commit hook, git exports the identity and the index of the commit in progress, and an environment variable
# beats what the tests' throwaway repositories set for themselves (the bump test saw the outer author). The tests must not
# see them. The index path is kept aside for the staged secret scan, which must read the index being committed.
hook_index="${GIT_INDEX_FILE:-}"
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE GIT_INDEX_FILE

failed=0

run() {
  local name="$1"; shift
  local out
  printf '%s ... ' "$name"
  if out="$("$@" 2>&1)"; then
    echo ok
  else
    echo FAIL
    printf '%s\n' "$out" | sed 's/^/    /'
    failed=$((failed + 1))
  fi
}

unavailable() {
  if $ci; then
    echo "$1 ... FAIL ($2; required with --ci)"
    failed=$((failed + 1))
  else
    echo "$1 ... SKIP ($2)"
  fi
}

# Run a check only if its tool is installed (always installed by mise; this guards a broken install).
needs() { # tool, name, command...
  local tool="$1" name="$2"; shift 2
  if command -v "$tool" >/dev/null 2>&1; then run "$name" "$@"; else unavailable "$name" "$tool not installed"; fi
}

needs tofu "tofu fmt" tofu fmt -check -recursive -diff infra

run "change-detection tests" bash .github/scripts/changed-services.test.sh
run "content-tag tests" bash .github/scripts/content-tag.test.sh
run "bump pull request tests" bash .github/scripts/bump-pr.test.sh
needs kubectl "image pin tests" bash .github/scripts/bump-images.test.sh

# Every kustomize directory under deploy/ renders, and what it renders is valid against the Kubernetes schemas of the
# cluster's version (the minor from mise.toml). Argo CD Applications and Gateway API routes are custom resources, so their
# schemas come from the datreeio CRD catalog, pinned to a commit (a schema, never code that runs).
CRD_SCHEMAS='https://raw.githubusercontent.com/datreeio/CRDs-catalog/4c8dc296d32b06d15ccde9668ff136c951f4d539/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'
validate_manifests() {
  local dir rc=0
  for dir in deploy/*/; do
    kubectl kustomize "$dir" | kubeconform -strict -summary -kubernetes-version "$K8S_VERSION.0" \
      -schema-location default -schema-location "$CRD_SCHEMAS" - || rc=1
  done
  return $rc
}
if command -v kubectl >/dev/null 2>&1; then
  needs kubeconform "manifest schemas" validate_manifests
else
  unavailable "manifest schemas" "kubectl not installed"
fi

# Workflow security (PLAN.md D24). Online in CI when a token is present, which adds the audits that ask GitHub (impostor
# commits, actions with known vulnerabilities); offline otherwise.
zizmor_check() {
  if $ci && [ -n "${GH_TOKEN:-}" ]; then
    zizmor --format plain .github
  else
    zizmor --offline --format plain .github
  fi
}
needs zizmor "zizmor" zizmor_check
needs actionlint "actionlint" actionlint -color=false

if $ci; then
  needs gitleaks "gitleaks (full history)" gitleaks git . --no-banner --redact
else
  needs gitleaks "gitleaks (staged changes)" env ${hook_index:+GIT_INDEX_FILE="$hook_index"} gitleaks git . --pre-commit --staged --no-banner --redact
fi

if [ "$failed" -ne 0 ]; then
  echo "$failed check(s) failed"
  exit 1
fi
echo "all checks passed"
